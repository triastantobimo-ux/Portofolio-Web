// ============================================================
// SCHEMA PRODUCTION (Vercel + Neon Postgres)
// Vercel build hanya menjalankan `prisma generate` dengan schema ini.
// Perubahan schema produksi harus diterapkan secara eksplisit setelah review
// menggunakan `bun run db:push:prod`; destructive change tidak di-auto-accept.
//
// Schema lokal (SQLite) tetap di prisma/schema.prisma
// sehingga preview sandbox tetap berjalan normal.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Buku tamu interaktif — pengunjung bisa meninggalkan pesan & menyukai pesan
model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  role      String?
  message   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Statistik situs: jumlah kunjungan
model SiteStats {
  id    String @id @default("main")
  views Int    @default(0)
}
