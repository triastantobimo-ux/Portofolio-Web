generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Buku tamu interaktif — pengunjung bisa meninggalkan pesan & menyukai pesan
model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  role      String?
  message   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Statistik situs: jumlah kunjungan
model SiteStats {
  id    String @id @default("main")
  views Int    @default(0)
}
